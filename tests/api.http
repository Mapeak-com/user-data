@host = http://localhost:3000
@token = TEST_TOKEN

###
# @name HealthCheck
GET {{host}}/health

?? status == 200
?? js response.body.status == "ok"

###
# @name CreateShare
POST {{host}}/api/urls
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "title": "Test Route",
    "description": "A test route created by httpyac",
    "type": "Hiking",
    "difficulty": "Easy",
    "public": true,
    "osmUserId": "test-user",
    "start": {
        "lat": 32.0853,
        "lng": 34.7818
    }
}

?? status == 200
?? js response.body.id.length > 0
?? js response.body.title == "Test Route"

###
# @name GetShare
GET {{host}}/api/urls/{{CreateShare.id}}
Authorization: Bearer {{token}}

?? status == 200
?? js response.body.id == "{{CreateShare.id}}"

###
# @name GetShareThumbnail - Should fail (404) initially
GET {{host}}/api/urls/{{CreateShare.id}}/thumbnail
Authorization: Bearer {{token}}

?? status == 404

###
# @name GetUserLayers - check empty initially
GET {{host}}/api/UserLayers
Authorization: Bearer {{token}}

?? status == 200
?? js Array.isArray(response.body)

###
# @name CreateUserLayer
POST {{host}}/api/UserLayers
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "key": "test-layer",
    "address": "https://example.com/{z}/{x}/{y}.png",
    "minZoom": 0,
    "maxZoom": 18,
    "opacity": 1.0,
    "isOverlay": false
}

?? status == 200
?? js response.body.key == "test-layer"

###
# @name DeleteShare
DELETE {{host}}/api/urls/{{CreateShare.id}}
Authorization: Bearer {{token}}

?? status == 200
