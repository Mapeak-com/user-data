{
  "name": "user-data",
  "version": "1.0.0",
  "description": "A microservice to manage the user data",
  "main": "index.ts",
  "scripts": {
    "generate-json": "js-yaml ./user-data.openapi.yml > ./src/user-data.openapi.json",
    "generate-types": "openapi-typescript ./user-data.openapi.yml -o ./src/types.g.d.ts",
    "build": "npm run generate-json && npm run generate-types && tsc",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mapeak-com/user-data.git"
  },
  "author": "Harel Mazor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Mapeak-com/user-data/issues"
  },
  "homepage": "https://github.com/Mapeak-com/user-data#readme",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/swagger-ui-express": "^4.1.8",
    "js-yaml": "^4.1.1",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "lru-cache": "^11.2.5",
    "swagger-ui-express": "^5.0.1"
  }
}